# /etc/hearth.env - read by systemd (EnvironmentFile) for hearth.service.
# Owned root:<app user>, mode 640. Never commit a filled-in copy.

# Your Qloo hackathon key (sent as X-Api-Key). install.sh asks for it if this is empty.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Private data: SQLite database and the Qloo response cache (never served, never committed).
HEARTH_DB=/var/lib/hearth/hearth.db
HEARTH_CACHE_DIR=/var/lib/hearth/cache/qloo

# Built web app (install.sh fills in the repo path).
HEARTH_WEB_DIST=@REPO@/web/dist

# Public hostname Caddy serves (install.sh fills this in: $HEARTH_DOMAIN or <ip-with-dashes>.sslip.io).
HEARTH_DOMAIN=

# Public-demo protection (per client IP, per worker process; requests/seconds).
HEARTH_RATE_LIMIT=1
HEARTH_RATE_QLOO=30/60
HEARTH_RATE_CREATE=20/3600
HEARTH_RATE_API=240/60
HEARTH_MAX_RESIDENTS_PER_HOME=12
